diff --git a/tests/SCSKiller.Tests/Carved/ArcPipelineCacheTests.cs b/tests/SCSKiller.Tests/Carved/ArcPipelineCacheTests.cs
new file mode 100644
--- /dev/null
+++ b/tests/SCSKiller.Tests/Carved/ArcPipelineCacheTests.cs
@@ -0,0 +1,24 @@
+using SCSKiller.Core;
+using SCSKiller.Core.Carved;
+using SCSKiller.Tests.Planning;
+
+namespace SCSKiller.Tests.Carved;
+
+public class ArcPipelineCacheTests
+{
+    [Fact]
+    public void ShaderContainersInTheMiddleOfAPipelineCacheAreDetected()
+    {
+        var dir = Ff7.TempDir("arc-pipeline-cache");
+        var path = Path.Combine(dir, "PipelineCache.bin");
+        using (var file = File.Create(path))
+        {
+            // Beyond an unnamed file's 4 MB sample, but inside a named file's 16 MB sample.
+            file.SetLength(80L << 20); file.Position = 8L << 20;
+            for (var i = 1; i <= 140; i++) { file.Write(Hlsl.Vs(i, Hlsl.Rs1)); file.Write(Hlsl.Ps(i, Hlsl.Rs1)); }
+        }
+        var game = new Game("test:arc-cache", "Synthetic install", Store.Other, dir, Path.Combine(dir, "game.exe"));
+        var engine = new CarvedReader().Detect(game)!;
+        Assert.Null(engine.Unsupported); Assert.Contains("+RTS0", engine.Version);
+    }
+}
