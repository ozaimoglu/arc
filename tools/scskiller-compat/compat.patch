diff --git a/tests/SCSKiller.Tests/Carved/ArcPipelineCacheTests.cs b/tests/SCSKiller.Tests/Carved/ArcPipelineCacheTests.cs
new file mode 100644
--- /dev/null
+++ b/tests/SCSKiller.Tests/Carved/ArcPipelineCacheTests.cs
@@ -0,0 +1,24 @@
+using SCSKiller.Core;
+using SCSKiller.Core.Carved;
+using SCSKiller.Tests.Planning;
+
+namespace SCSKiller.Tests.Carved;
+
+public class ArcPipelineCacheTests
+{
+    [Fact]
+    public void ShaderContainersInTheMiddleOfAPipelineCacheAreDetected()
+    {
+        var dir = Ff7.TempDir("arc-pipeline-cache");
+        var path = Path.Combine(dir, "PipelineCache.bin");
+        using (var file = File.Create(path))
+        {
+            // Beyond an unnamed file's 4 MB sample, but inside a named file's 16 MB sample.
+            file.SetLength(80L << 20); file.Position = 8L << 20;
+            for (var i = 1; i <= 140; i++) { file.Write(Hlsl.Vs(i, Hlsl.Rs1)); file.Write(Hlsl.Ps(i, Hlsl.Rs1)); }
+        }
+        var game = new Game("test:arc-cache", "Synthetic install", Store.Other, dir, Path.Combine(dir, "game.exe"));
+        var engine = new CarvedReader().Detect(game)!;
+        Assert.Null(engine.Unsupported); Assert.Contains("+RTS0", engine.Version);
+    }
+}
diff --git a/tests/SCSKiller.Tests/Unreal/ArcUnrealMountTests.cs b/tests/SCSKiller.Tests/Unreal/ArcUnrealMountTests.cs
new file mode 100644
--- /dev/null
+++ b/tests/SCSKiller.Tests/Unreal/ArcUnrealMountTests.cs
@@ -0,0 +1,42 @@
+using System.Reflection;
+using System.Runtime.ExceptionServices;
+using CUE4Parse.FileProvider;
+using CUE4Parse.UE4.Versions;
+using SCSKiller.Core.Unreal;
+using SCSKiller.Tests.Planning;
+
+namespace SCSKiller.Tests.Unreal;
+
+public class ArcUnrealMountTests
+{
+    [Fact]
+    public void MalformedLocalizationDoesNotBlockShaderArchiveReading()
+    {
+        using var provider = new DefaultFileProvider(Ff7.TempDir("arc-ini"), SearchOption.TopDirectoryOnly,
+            new VersionContainer(EGame.GAME_UE5_5), StringComparer.OrdinalIgnoreCase);
+        provider.DefaultGame.Read(new StringReader("[Internationalization]\n+CultureMappings=malformed\n"));
+        var method = typeof(InternationalizationDictionary).GetMethod("InitFromIni", BindingFlags.NonPublic | BindingFlags.Instance)!;
+        void Initialize()
+        {
+            try { method.Invoke(provider.Internationalization, [provider.DefaultGame, provider]); }
+            catch (TargetInvocationException e) when (e.InnerException != null) { ExceptionDispatchInfo.Capture(e.InnerException).Throw(); }
+        }
+        Assert.Throws<IndexOutOfRangeException>(Initialize);
+        var log = new Capture();
+        UnrealReader.PostMountForShaders(Initialize, log);
+        Assert.Contains("localization mapping", log.Line);
+    }
+
+    [Fact]
+    public void UnrelatedArchiveAndBoundsErrorsRemainFatal()
+    {
+        Assert.Throws<InvalidDataException>(() => UnrealReader.PostMountForShaders(() => throw new InvalidDataException("archive")));
+        Assert.Throws<IndexOutOfRangeException>(() => UnrealReader.PostMountForShaders(() => throw new IndexOutOfRangeException("shader")));
+    }
+
+    sealed class Capture : IProgress<string>
+    {
+        public string Line = "";
+        public void Report(string line) => Line = line;
+    }
+}
