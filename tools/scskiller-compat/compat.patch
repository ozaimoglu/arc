+    internal static void PostMountForShaders(Action postMount, IProgress<string>? log = null)
+    {
+        try { postMount(); }
+        catch (IndexOutOfRangeException e) when (LocalizationMappingFailure(e))
+        {
+            // CUE4Parse splits CultureMappings on ';' without validating its length. Localization is unrelated
+            // to shader archives, which are already mounted. Keep archive/decryption errors fatal.
+            log?.Report("Unreal: malformed localization mapping ignored; reading mounted shader archives.");
